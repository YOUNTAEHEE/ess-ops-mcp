import test from 'node:test';import assert from 'node:assert/strict';import {executeTool,rpc,tools,providerInvocations} from '../lib/ops.ts';
test('lifecycle, discovery and notifications',async()=>{const i=await rpc({jsonrpc:'2.0',id:1,method:'initialize',params:{protocolVersion:'2025-06-18'}},false);assert.equal((i.body?.result as any).protocolVersion,'2025-06-18');const l=await rpc({jsonrpc:'2.0',id:2,method:'tools/list'},false);assert.equal((l.body?.result as any).tools.length,6);assert.ok(tools.every(t=>t.annotations.readOnlyHint));assert.equal((await rpc({jsonrpc:'2.0',method:'notifications/initialized'},false)).status,202);});
test('calls require identity',async()=>{assert.equal((await rpc({jsonrpc:'2.0',id:3,method:'tools/call',params:{name:'get_equipment_status'}},false)).status,401);});
test('normal, partial failure and recovery',async()=>{const ok=await executeTool('get_equipment_status',{}) as any;assert.equal(ok.available.length,4);assert.equal(ok.partial,false);for(const scenario of ['timeout','offline']){const d=await executeTool('get_equipment_status',{scenario}) as any;assert.equal(d.available.length,3);assert.equal(d.failures.length,1);assert.equal(d.failures[0].data,null);assert.equal(d.failures[0].attempts,2);}const r=await executeTool('get_equipment_status',{scenario:'flaky'}) as any;assert.equal(r.available.length,4);assert.equal(r.available.find((d:any)=>d.id==='ESS-B02').attempts,2);});
test('inflight sharing',async()=>{const b=providerInvocations;const [x,y]=await Promise.all([executeTool('get_equipment_status',{}),executeTool('get_equipment_status',{})]);assert.deepEqual(x,y);assert.equal(providerInvocations-b,4);});
test('telemetry order and limits',async()=>{const d=await executeTool('query_telemetry',{equipment_id:'ESS-A01',minutes:60,interval_minutes:5}) as any;assert.equal(d.points.length,13);assert.equal(Date.parse(d.points[1].timestamp)-Date.parse(d.points[0].timestamp),300000);for(const args of [{equipment_id:'unknown'},{equipment_id:'ESS-A01',minutes:999999},{equipment_id:'ESS-A01',minutes:-1},{equipment_id:'ESS-A01',interval_minutes:2},{equipment_id:'ESS-A01',extra:true}])await assert.rejects(executeTool('query_telemetry',args));});
test('explanation uses exact demo evidence',async()=>{const d=await executeTool('explain_alarm',{alarm_id:'ALM-001'}) as any;assert.equal(d.method,'deterministic-rule');assert.equal(d.alarm.observed,38.6);assert.equal(d.alarm.threshold,35);assert.match(d.alarm.evidence,/38.6/);});
test('protocol error semantics',async()=>{assert.equal((await rpc([],true)).status,400);assert.equal((await rpc({jsonrpc:'2.0',id:1,method:'unknown'},true)).body?.error?.code,-32601);assert.equal((await rpc({jsonrpc:'2.0',id:1,method:'tools/call',params:{name:'control_device'}},true)).body?.error?.code,-32602);assert.equal((await rpc({jsonrpc:'2.0',id:1,method:'tools/call',params:{name:'query_telemetry',arguments:{equipment_id:'wrong'}}},true)).body?.error?.code,-32602);});
